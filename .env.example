# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — Settings → API Keys & Webhooks (use test keys in development)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL this app is served from. Used to build the Paystack
# callback URL. Set to your real domain in production.
APP_URL=http://localhost:3000

# Telegram community invite, shown only to enrolled students on the
# welcome page. Server-side only — never prefix with NEXT_PUBLIC_.
TELEGRAM_INVITE_LINK=https://t.me/your_invite_link_here
