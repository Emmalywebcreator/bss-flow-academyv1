# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — Settings → API Keys & Webhooks (use test keys in development)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL this app is served from. Used to build the Paystack
# callback URL. Set to your real domain in production.
APP_URL=http://localhost:3000

# Resend — emails the login codes enrolled students use to log in on
# another device (resend.com → API Keys). EMAIL_FROM must use a domain
# verified in Resend. Leave RESEND_API_KEY empty locally to print codes
# to the dev server console instead.
RESEND_API_KEY=
EMAIL_FROM="BSS Flow Academy <login@bssflow.cloud>"

# Telegram community invite, shown only to enrolled students on the
# welcome page. Server-side only — never prefix with NEXT_PUBLIC_.
TELEGRAM_INVITE_LINK=https://t.me/your_invite_link_here
